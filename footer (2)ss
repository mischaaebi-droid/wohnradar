/* Wohnradar – dezenter, zentral eingebundener Klappfooter */
.wr-footer {
  width: 100%;
  margin: 0;
  border: 0;
  border-top: 1px solid #DFCFC7;
  border-radius: 0;
  background: #FAF6F2;
  color: #352A28;
  font-family: inherit;
  font-size: 13px;
  line-height: 1.5;
}
.wr-footer, .wr-footer * { box-sizing: border-box; }
.wr-footer .wr-footer__details { margin: 0; padding: 0; border: 0; }
.wr-footer .wr-footer__toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  margin: 0;
  padding: 10px 16px;
  border: 0;
  background: transparent;
  color: #786761;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
  list-style: none;
  cursor: pointer;
}
.wr-footer .wr-footer__toggle::-webkit-details-marker { display: none; }
.wr-footer .wr-footer__toggle::marker { content: ''; }
.wr-footer .wr-footer__toggle:hover { color: #352A28; }
.wr-footer .wr-footer__toggle:focus-visible {
  outline: 2px solid #B0523B;
  outline-offset: -3px;
}
.wr-footer .wr-footer__chevron {
  display: inline-block;
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
  transition: transform .2s ease;
}
.wr-footer .wr-footer__details[open] .wr-footer__chevron {
  transform: rotate(225deg) translateY(-1px);
}
.wr-footer .wr-footer__inner {
  max-width: 1000px;
  margin: 0 auto;
  padding: 16px 24px 22px;
  border-top: 1px solid #DFCFC7;
}
.wr-footer .wr-footer__grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr;
  gap: 24px;
}
.wr-footer .wr-footer__grid > * { min-width: 0; }
.wr-footer a { color: #786761; text-decoration: none; }
.wr-footer a:hover { color: #893C2B; text-decoration: underline; text-underline-offset: 3px; }
.wr-footer a:focus-visible { outline: 2px solid #B0523B; outline-offset: 3px; }
.wr-footer .wr-footer__brand {
  display: inline-block;
  color: #352A28;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -.7px;
}
.wr-footer .wr-footer__brand em { color: #B0523B; font-style: normal; }
.wr-footer .wr-footer__intro p { margin: 5px 0 0; color: #786761; }
.wr-footer .wr-footer__nav h2 {
  margin: 0 0 8px;
  color: #352A28;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.4;
}
.wr-footer .wr-footer__nav ul { list-style: none; padding: 0; margin: 0; }
.wr-footer .wr-footer__nav li { margin: 0; padding: 0; }
.wr-footer .wr-footer__nav a,
.wr-footer .wr-footer__pending {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 0 6px;
  align-items: baseline;
  padding: 5px 0;
  min-height: 30px;
  overflow-wrap: anywhere;
}
.wr-footer .wr-footer__pending { color: #897C76; cursor: default; }
.wr-footer .wr-footer__pending small { font-size: 11px; }
.wr-footer a[aria-current="page"] { color: #893C2B; font-weight: 700; }
.wr-footer .wr-footer__bottom {
  display: flex;
  justify-content: flex-end;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #DFCFC7;
  font-size: 12px;
}
.wr-footer .wr-footer__bottom a { padding: 5px 0; }
/* Die Rechnerseiten enthalten teilweise Skripte zwischen .wrap und dem Footer.
   Deshalb allgemeiner Geschwisterselektor (~) statt direktem (+). */
.wrap:has(~ #wohnradar-footer) { padding-bottom: 16px; }
@media (max-width: 760px) {
  .wr-footer .wr-footer__grid { grid-template-columns: 1fr 1fr; gap: 18px; }
  .wr-footer .wr-footer__intro { grid-column: 1 / -1; }
}
@media (max-width: 530px) {
  .wrap:has(~ #wohnradar-footer) { padding-bottom: 12px; }
  .wr-footer .wr-footer__toggle { min-height: 42px; padding: 9px 10px; font-size: 11.5px; }
  .wr-footer .wr-footer__inner { padding: 14px 20px 18px; }
  .wr-footer .wr-footer__grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  .wr-footer .wr-footer__intro { grid-column: 1 / -1; }
}
@media (prefers-reduced-motion: reduce) {
  .wr-footer .wr-footer__chevron { transition: none; }
}
